TEXT 912 -1008 Left 2 !; --- target operating point ---\n.param VREG=3.3\n \n; --- AAA Battery Test Conditions(L92) ---\n \n.step param V_AAA list 1.3 1.5 1.7 param R_AAA list 0.23 0.27 0.31 0.35\n \n; --- CR2032 Battery Test Conditions (Energizer) ---\n \n.step param V_COIN list 2.5 2.8 3.0 param R_AAA list 20 40 100\n \n; --- test currents ---\n.param I_START=0.5\n.param I_IDLE=0.11\n.param I_WORST=0.5\n \n; --- convert to equivalent resistances ---\n.param R_START = VREG/I_START\n.param R_IDLE  = VREG/I_IDLE\n.param R_WORST = VREG/I_WORST\n \n; --- timing ---\n.param T_EN=5m\n.param T_START_END=15m\n.param T_WORST=20m\n \n; --- edge smoothing ---\n.param TR=10u
TEXT 744 752 Left 2 !.func VIN_74() {V(V_BACKUP)}\n.func TD_74() { 5n }\n.func TRF_74() { 20n*(3/max(VIN_74(),0)) }\n.func VIH_74()   { 0.7*VIN_74() }\n.func VIL_74()   { 0.3*VIN_74() }\n.func VHIGH_74() {VIN_74()-0.1}\n.func VLOW_74() {0.05}\n.func VOH_74() {VIN_74()-0.1}\n.func VOL_74() {0.1}
