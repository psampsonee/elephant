CXX := g++
CXXFLAGS := \
-std=c++20  -g3 -O0 -Wall -Wextra -Wpedantic -IStorage/Inc \
-IAudio/Inc -ITest/Inc

SRC := \
Storage/Src/storage_device_fake.cpp \
Audio/Src/ADPCM_sample_source.cpp \
Audio/Src/ADPCM_codec.cpp

TEST_SRC := \
Test/Src/test_ADPCM_sample_source.cpp \
Test/Src/ADPCM_sample_source_test_handles.cpp \
Test/Src/magic_result.cpp

BUILD_DIR := Test/build
TARGET := $(BUILD_DIR)/test_ADPCM_sample_source

.PHONY: all test clean

all: test

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

$(TARGET): $(SRC) $(TEST_SRC) | $(BUILD_DIR)
	$(CXX) $(CXXFLAGS) $^ -o $@

test: $(TARGET)
	./$(TARGET)

clean:
	rm -rf $(BUILD_DIR)
