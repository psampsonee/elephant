CXX := g++
CXXFLAGS := -std=c++17  -g3 -O0 -Wall -Wextra -Wpedantic -IStorage/Inc -ITest/Inc
SRC := \
Storage/Src/storage_device_fake.cpp

TEST_SRC := \
Test/storage_device_fake_test_handles.cpp \
Test/test_storage_device_fake.cpp

BUILD_DIR := Test/build
TARGET := $(BUILD_DIR)/test_storage_device_fake

.PHONY: all test clean

all: test

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

$(TARGET): $(SRC) $(TEST_SRC) | $(BUILD_DIR)
	$(CXX) $(CXXFLAGS) $^ -o $@

test: $(TARGET)
	./$(TARGET)

clean:
	rm -rf $(BUILD_DIR)
