TEXT 48 -1104 Left 2 !.param RON=0.14  ROFF=1e9  RREV=1.4e6 RST_OFF=1e15 RST_ON=50\n.param VENON=-80m VENOFF=5m\n.param RVBLOCKOFF=-15m\n.param RVBLOCKON=15m\n \n* RC Filter for chip state logic\n.param Taufilter=1m\n.param Cfilter= 1n\n.param Rfilter= {Taufilter/Cfilter}\n.param logicDelay = 500u\n \n* Turn on/off characteristics\n.param TransTau_on=18u TransTau_off=2u\n \n* Chip state logic\n.func FCHIPLATCH(x) {delay(if(x<VENON,1,0),logicDelay)}\n.func FCHIPUNLATCH(x) {delay(if(x>VENOFF,1,0),logicDelay)}\n \n* Block state logic\n.func FBLOCKLATCH(x) {delay(if(x>RVBLOCKON,1,0),logicDelay)}\n.func FBLOCKUNLATCH(x) {delay(if(x<RVBLOCKOFF,1,0),logicDelay)}\n \n.func ENEFF() { min(V(EN), (1-V(RVBLOCK))) }\n.func Rpath() { 1 / ( 1/ROFF + (1/RON - 1/ROFF)*limit(V(transition),0,1) ) }\n*.func Rpath() { if(ENEFF()>0.5, RON, ROFF) }\n.func Rdrain() { if(ENEFF()>0.5,RST_OFF,RST_ON) }\n.func TransTau() { if(ENEFF()>0.5,TransTau_on,TransTau_off) }\n.func Irev(v) { table(v, 0, 0, 1, 2.1u, 5.5, 8u) }\n.meas tran ron_val param {RON}
